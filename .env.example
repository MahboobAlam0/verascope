# Copy this file to .env and fill in real values. Never commit the real .env file.

# --- LLM provider (added in Phase 7 - not yet required for ingestion/classification) ---
# Exactly one of these will be used depending on which provider is selected.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=

# Which provider/model the extraction stages should call.
# Options: "anthropic" | "openai" | "groq" | "gemini"
LLM_PROVIDER=

# Optional: override the default model for each provider (e.g. if the
# hardcoded default snapshot becomes deprecated). Leave blank to use the
# client's built-in default.
ANTHROPIC_MODEL=
OPENAI_MODEL=
GROQ_MODEL=
GEMINI_MODEL=

# --- Pipeline behavior ---
# Directory containing input PDFs to process.
INPUT_DIR=data/input

# Directory where final_output.json / evidence.json are written per document.
OUTPUT_DIR=data/output

# Logging verbosity: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
