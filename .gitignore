# Secrets - never commit real credentials
.env

# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
build/
dist/

# Virtual environments
.venv/
venv/
env/

# OS noise
.DS_Store
Thumbs.db

# Editor/IDE - shared launch/settings/extensions configs are tracked
# on purpose (README points to them), everything else in .vscode/ isn't.
.vscode/*
!.vscode/launch.json
!.vscode/settings.json
!.vscode/extensions.json
.idea/

# data/output/ holds this project's actual generated results
# (final_output.json / evidence.json per document) - these are real
# deliverables the README's Results section refers to, not throwaway
# build artifacts, so they're tracked rather than ignored.
.venv/

data/input

# Local input PDFs are provided by the assignment sample set and checked in
# under data/input/ deliberately, so no ignore rule for that directory.
